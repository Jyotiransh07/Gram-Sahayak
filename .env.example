# Copy this file to .env. Never upload .env to GitHub.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
VISION_MODEL=qwen2.5vl:3b

# Optional cloud Gemini: leave false for fully local AI; free tier is quota-limited.
USE_GEMINI=false
USE_LLM_VERIFIER=false
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional data.gov.in mandi access. Visit the selected dataset's Data API page.
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional Telegram bot from BotFather.
TELEGRAM_BOT_TOKEN=

# Configure a distinctive User-Agent identifying your application before OSM lookup.
OSM_USER_AGENT=GramSahayakEducationalProject/1.0

# Optional semantic document index (downloaded once then used locally).
RAG_MODEL=intfloat/multilingual-e5-small

# gtts=no-key online unofficial speech service; mms=local offline speech models.
TTS_BACKEND=gtts

# Frontend connects to a local backend. Do not expose unauthenticated APIs publicly.
BACKEND_URL=http://127.0.0.1:8000
